{
  "name": "pixel-birthday",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config platform/vite.config.ts --host 0.0.0.0",
    "api": "wrangler dev --config wrangler.jsonc --port 8787",
    "build": "vite build --config platform/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply pixel --local",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "better-auth": "^1.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.0.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^18.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.0.0"
  }
}
